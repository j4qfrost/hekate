# Copy to .env and edit. Every variable below is optional in dev.

# POSTGRES_USER=hekate
# POSTGRES_PASSWORD=hekate
# POSTGRES_DB=hekate

# HEKATE_RELAY_URL=wss://bsky.network/xrpc/com.atproto.sync.subscribeRepos
# HEKATE_RECURRENCE_HORIZON_DAYS=90

# Used by the web client to reach the server. Set to your public origin in
# production (e.g. https://api.hekate.example).
# WEB_PUBLIC_API_URL=http://localhost:8080

# Host ports published by docker-compose.yml. Override to avoid collisions
# with other local services.
# HEKATE_SERVER_PORT=8080
# WEB_PORT=5173

# Host ports published by the observability stack (observability/docker-compose.yml).
# All bound to 127.0.0.1 (loopback-only). Override to avoid local collisions.
# OBSERVABILITY_GRAFANA_PORT=3001
# OBSERVABILITY_OTLP_GRPC_PORT=4317
# OBSERVABILITY_OTLP_HTTP_PORT=4318
# OBSERVABILITY_LOKI_PORT=3100
# OBSERVABILITY_TEMPO_PORT=3200
# OBSERVABILITY_MIMIR_PORT=9009
